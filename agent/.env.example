# LiveKit — get these from https://cloud.livekit.io after creating a project
LIVEKIT_URL=wss://your-project-name.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_secret_here

# Groq — get from https://console.groq.com (free)
# Used for: STT (Whisper) + LLM (Llama 3.3 70B)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Deepgram — get from https://console.deepgram.com (free tier)
# Used for: TTS (text-to-speech, the AI's voice)
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
